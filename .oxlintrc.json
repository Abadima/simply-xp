{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"typescript",
		"unicorn",
		"oxc",
		"promise",
		"import",
		"node"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn"
	},
	"env": {
		"builtin": true,
		"node": true,
		"es2022": true
	},
	"ignorePatterns": [
		"lib",
		"node_modules",
		"Tests/assets",
		"Tests/Images"
	],
	"rules": {
		"no-case-declarations": "error",
		"no-fallthrough": "error",
		"no-throw-literal": "error",
		"no-self-compare": "error",
		"typescript/no-misused-promises": "error",
		"no-use-before-define": [
			"error",
			{
				// Allowed: JS function declarations are hoisted.
				"functions": false,
				// Enforced: const/let/class have TDZ runtime risks.
				"classes": true,
				"variables": true,
				"enums": true,
				"typedefs": false,
				"ignoreTypeReferences": true
			}
		],
		// Type-only cycles are erased at compile time and carry no runtime risk.
		"import/no-cycle": [
			"error",
			{
				"ignoreTypes": true
			}
		],
		"require-unicode-regexp": "error",
		// `testXpRateBulkSync` is a test name (bulk xp_rate synchronization), not a call
		// to a synchronous API; the rule otherwise matches any "...Sync"-suffixed callee.
		"node/no-sync": ["error", { "ignores": ["testXpRateBulkSync"] }],
		// `Database`, `Migrate`, `LevelRoles`, `XpLog` and `XpEvents` are intentionally
		// static-only classes. That is the documented public API shape (`Database.findOne()`,
		// `LevelRoles.add()`, ...), not an accident.
		"typescript/no-extraneous-class": "off",
		// `_id` is MongoDB's document identifier. We do not get to rename it.
		"no-underscore-dangle": "off",
		// `Array#toSorted()` requires Node 20; simply-xp supports Node 14+.
		// The arrays we sort are freshly built from query results, so in-place sort is safe.
		"unicorn/no-array-sort": "off",
		// Migrations and duplicate remediation await sequentially on purpose, to avoid
		// firing an unbounded number of concurrent queries at a user's database.
		"no-await-in-loop": "off",
		// Flags `.then()` callbacks that do not return. In `registerFont()` the chain is
		// awaited and the result intentionally discarded, so there is no broken chain.
		"promise/always-return": "off"
	}
}