  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abadima/simply-xp.git"
  },
  "main": "simplyxp.js",
  "typings": "index.d.ts",
  "scripts": {
    "test": "node Tests/regression.test.cjs && node Tests/cards.test.cjs",
    "test:cards": "node Tests/cards.test.cjs",
    "lint": "oxlint && oxfmt --check simplyxp.js src Tests",
    "fix": "oxlint --fix && oxfmt simplyxp.js src Tests",
    "codacy": "rm -f .codacy/remote.config.json .codacy/remote.config.baseline.json && codacy-analysis init --remote gh Abadima simply-xp --config-file .codacy/remote.config.json --no-update-notifier && codacy-analysis analyze . --config-file .codacy/remote.config.json --install-dependencies --no-update-notifier",
    "legacy": "pnpm run fix && pnpm update && npm publish --tag legacy"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.1",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "peerDependencies": {
    "discord.js": "^13.12.0 || ^14.19.0"
  },
  "engines": {
    "node": ">=16.20.1"
  },
  "readme": "README.md"
}